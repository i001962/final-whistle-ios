# Xcode
DerivedData.noindex/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
Package.resolved

# macOS
.DS_Store

# Keys and secrets. Never commit custody keys, signer seeds, or any private key.
*.key
*-key.txt
*-signer.txt
custody-key.txt
signer-seed.txt
# App API keys (pfp upload). Copy FinalWhistle/Secrets.example.swift
# to FinalWhistle/Secrets.swift and fill in the real values locally.
FinalWhistle/Secrets.swift

# Development team id for the phone build. The team id is not a
# secret (it is in the app's code signature), but it is machine-
# specific, so phone.sh keeps it in this local file instead of
# relying on project.pbxproj surviving a pull.
scripts/.development-team
